FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /srv/seum
RUN useradd -r -u 10001 -m seum && python -m pip install --no-cache-dir 'mcp==2.0.0'
COPY --chown=seum:seum contract_forge.py /srv/seum/contract_forge.py
COPY --chown=seum:seum examples/ /srv/seum/examples/
COPY --chown=seum:seum enterprise_mcps/ /srv/seum/enterprise_mcps/
USER seum
EXPOSE 8080
CMD ["python", "-m", "enterprise_mcps.http_server"]
