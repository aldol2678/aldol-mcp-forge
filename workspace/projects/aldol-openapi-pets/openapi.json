{
  "openapi": "3.1.0",
  "info": {
    "title": "ALDOL Example Pet API",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "get": {
        "summary": "Read list of sample pets",
        "operationId": "list_pets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ]
      },
      "post": {
        "operationId": "create_pet"
      }
    },
    "/pets/{pet_id}": {
      "get": {
        "summary": "Read one sample pet",
        "operationId": "get_pet",
        "parameters": [
          {
            "name": "pet_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
