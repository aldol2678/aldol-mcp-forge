{
  "version": "0.3",
  "title": "꼬마 군단 원정대 · 범용 HUD 데모",
  "preset": "forest",
  "tokens": {
    "density": "compact",
    "radius": "soft",
    "font": "system"
  },
  "root": {
    "type": "stack",
    "children": [
      {
        "type": "panel",
        "label": "전투 상단 정보",
        "children": [
          {
            "type": "row",
            "children": [
              {
                "type": "text",
                "text": "제2장 · 숲의 길목",
                "variant": "eyebrow"
              },
              {
                "type": "badge",
                "text": "전투 중",
                "tone": "success",
                "bind": "battle-status"
              }
            ]
          },
          {
            "type": "text",
            "text": "군단 체력 72 / 100",
            "variant": "heading",
            "bind": "health-title"
          },
          {
            "type": "progress",
            "label": "군단 체력",
            "value": 72,
            "max": 100,
            "bind": "health"
          },
          {
            "type": "grid",
            "columns": 2,
            "children": [
              {
                "type": "metric",
                "label": "아군 병력",
                "value": "12",
                "bind": "ally-count"
              },
              {
                "type": "metric",
                "label": "남은 적",
                "value": "2",
                "tone": "warning",
                "bind": "foe-count"
              }
            ]
          }
        ]
      },
      {
        "type": "panel",
        "label": "전투 명령",
        "children": [
          {
            "type": "text",
            "text": "전투 명령",
            "variant": "eyebrow"
          },
          {
            "type": "row",
            "children": [
              {
                "type": "button",
                "label": "전술",
                "action": {
                  "type": "toggle",
                  "target": "tactics"
                }
              },
              {
                "type": "button",
                "label": "상태이상",
                "variant": "secondary",
                "action": {
                  "type": "toggle",
                  "target": "conditions"
                }
              }
            ]
          },
          {
            "type": "panel",
            "id": "tactics",
            "hidden": true,
            "label": "전술 정보",
            "children": [
              {
                "type": "text",
                "text": "전술 정보",
                "variant": "heading"
              },
              {
                "type": "text",
                "text": "방패병은 전열을 유지하고 궁수는 후방 적을 우선 공격합니다.",
                "variant": "muted"
              },
              {
                "type": "button",
                "label": "반격 요청",
                "action": {
                  "type": "emit",
                  "name": "battle:counter"
                }
              }
            ]
          },
          {
            "type": "panel",
            "id": "conditions",
            "hidden": true,
            "label": "상태이상 정보",
            "children": [
              {
                "type": "text",
                "text": "상태이상",
                "variant": "heading"
              },
              {
                "type": "row",
                "children": [
                  {
                    "type": "badge",
                    "text": "중독 · 2턴",
                    "tone": "danger"
                  },
                  {
                    "type": "badge",
                    "text": "방어 강화",
                    "tone": "success"
                  }
                ]
              },
              {
                "type": "notice",
                "text": "상태이상은 예시 데이터로 표시됩니다.",
                "tone": "warning"
              }
            ]
          },
          {
            "type": "text",
            "text": "자동 전투 진행 중 · 터치하여 세부정보 확인",
            "variant": "muted"
          }
        ]
      }
    ]
  },
  "design": {
    "context": "game",
    "brand_note": "전투 판단을 먼저 보여주는 군단 전술 HUD, 숲·황동·절제된 전장 분위기"
  },
  "data_mode": "demo"
}
